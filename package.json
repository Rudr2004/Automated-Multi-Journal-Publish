{
  "name": "automated-journal-prototype",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:j1": "cross-env VITE_JOURNAL=j1 vite --port 5173 --strictPort",
    "dev:j2": "cross-env VITE_JOURNAL=j2 vite --port 5174 --strictPort",
    "dev:j3": "cross-env VITE_JOURNAL=j3 vite --port 5175 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:j1": "cross-env VITE_JOURNAL=j1 npm run build",
    "build:j2": "cross-env VITE_JOURNAL=j2 npm run build",
    "build:j3": "cross-env VITE_JOURNAL=j3 npm run build",
    "preview": "vite preview"
  },
  "engines": { "node": ">=20.19.0" },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "framer-motion": "^14.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.7.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
